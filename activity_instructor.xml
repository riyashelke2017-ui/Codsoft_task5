<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_attendance">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INSTRUCTOR PANEL"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/sage_green"
            android:layout_marginTop="15dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage courses and student roster"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"/>

        <!-- Course Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Course Information"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="30dp"/>

        <EditText
            android:id="@+id/edtCourse"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter Course Name"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="@color/soft_blue"
            android:layout_marginTop="12dp"/>

        <!-- Student Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Roster"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="25dp"/>

        <EditText
            android:id="@+id/edtStudent"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter Student Name"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="@color/peach"
            android:layout_marginTop="12dp"/>

        <!-- Add Button -->
        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="ADD COURSE / STUDENT"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/butter_yellow"
            android:layout_marginTop="22dp"/>

        <!-- Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add course information and assign students to the roster."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="18dp"/>

    </LinearLayout>

</ScrollView>
